default_platform(:ios)

platform :ios do
  before_all do |lane, options|
    UI.message("🚀 Starting Core CI/CD Pipeline lane: [#{lane}]")
  end

  desc "Evrensel Test Koşucusu: Unit & UI testlerini scan ile çalıştırır"
  lane :universal_test do |options|
    app_scheme       = options[:scheme] || UI.user_error!("Lütfen :scheme parametresini belirtin!")
    app_name         = options[:app_name] || app_scheme
    test_device      = options[:device] || "iPhone 16"
    clean_build      = options.fetch(:clean, true)
    code_coverage    = options.fetch(:code_coverage, true)
    output_dir       = options[:output_directory] || "./fastlane/test_output"

    scan_args = {
      scheme: app_scheme,
      devices: [test_device],
      clean: clean_build,
      code_coverage: code_coverage,
      output_directory: output_dir,
      fail_build: true
    }
    scan_args[:workspace] = options[:workspace] if options[:workspace]
    scan_args[:project]   = options[:project] if options[:project]

    UI.important("🧪 Running tests for #{app_scheme} on #{test_device}...")
    scan(scan_args)

    send_detailed_slack(
      app_name: app_name,
      status: "Success",
      dry_run: options[:dry_run] || false
    )
  end

  desc "Evrensel Derleme: Gym ile IPA veya app çıktısı üretir"
  lane :universal_build do |options|
    app_scheme       = options[:scheme] || UI.user_error!("Lütfen :scheme parametresini belirtin!")
    app_name         = options[:app_name] || app_scheme
    export_method    = options[:export_method] || "development"
    output_dir       = options[:output_directory] || "./build"
    configuration    = options[:configuration] || "Release"
    clean_build      = options.fetch(:clean, true)

    gym_args = {
      scheme: app_scheme,
      export_method: export_method,
      output_directory: output_dir,
      configuration: configuration,
      clean: clean_build
    }
    gym_args[:workspace] = options[:workspace] if options[:workspace]
    gym_args[:project]   = options[:project] if options[:project]

    UI.important("🔨 Building #{app_scheme} with export method #{export_method}...")
    build_app(gym_args)

    send_detailed_slack(
      app_name: app_name,
      status: "Success",
      dry_run: options[:dry_run] || false
    )
  end

  desc "Evrensel TestFlight Dağıtımı: Match + Gym + Pilot"
  lane :universal_testflight_deploy do |options|
    app_scheme       = options[:scheme] || UI.user_error!("Lütfen :scheme parametresini belirtin!")
    bundle_id        = options[:bundle_id] || UI.user_error!("Lütfen :bundle_id parametresini belirtin!")
    app_name         = options[:app_name] || app_scheme

    # App Store Connect API Key Entegrasyonu (Opsiyonel)
    if options[:api_key_path] && options[:key_id] && options[:issuer_id]
      app_store_connect_api_key(
        key_id: options[:key_id],
        issuer_id: options[:issuer_id],
        key_filepath: options[:api_key_path],
        duration: 1200,
        in_house: false
      )
    end

    # Fastlane Match ile Sertifikaları Çek
    if options[:git_url] || ENV["MATCH_GIT_URL"]
      match(
        type: "appstore",
        app_identifier: bundle_id,
        readonly: true
      )
    end

    # IPA Derleme
    build_app(
      scheme: app_scheme,
      export_method: "app-store",
      clean: true
    )

    # TestFlight Yükleme
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )

    send_detailed_slack(
      app_name: app_name,
      status: "Success",
      dry_run: options[:dry_run] || false
    )
  end

  desc "Simülasyon / Mock Dağıtım: Gerçek Apple Developer hesabı olmadan altyapıyı doğrular"
  lane :universal_mock_deploy do |options|
    app_scheme = options[:scheme] || "SampleApp"
    app_name   = options[:app_name] || app_scheme
    bundle_id  = options[:bundle_id] || "com.ci.sample"

    UI.important("=" * 60)
    UI.important("🚀 [MOCK DEPLOY] Simulating Core CI/CD Pipeline")
    UI.message("1. Validating Signing Profiles for Bundle ID: #{bundle_id} [MOCK OK]")
    UI.message("2. Archiving Scheme: #{app_scheme} [MOCK OK]")
    UI.message("3. Uploading to TestFlight: #{bundle_id} (Skipping binary push) [MOCK OK]")
    UI.important("=" * 60)

    send_detailed_slack(
      app_name: app_name,
      status: "Success",
      version_number: options[:version] || "1.0.0",
      build_number: options[:build] || "1",
      dry_run: true
    )
  end

  error do |lane, exception|
    UI.error("❌ Pipeline failed on lane: [#{lane}] with error: #{exception.message}")
    send_detailed_slack(
      app_name: "iOS CI/CD Core",
      status: "Failed",
      error_message: exception.message,
      dry_run: true
    )
  end
end
